    <!-- Первая новость -->
    <item>
        <title>Новость 1</title>
        <link>https://example.com</link>
        <description>Просто будть хорошим 🥰</description>
        <pubDate>Tue, 25 Aug 2026 01:00:00 +0700</pubDate>
        <guid isPermaLink="false">id-1-1</guid> 

        <content:encoded><![CDATA[
            <!-- ИСПРАВЛЕНО: Указаны точные размеры изображений для Picsum -->
            <img src="https://picsum.photos" alt="Первая картинка" /><br/>
            
            <!-- ПРИМЕР 1: Цветной текст через тег <p> -->
            <p style="color: #ff4757; font-weight: bold;">Это красный выделенный текст под первой картинкой.</p>
            <br/>
            
            <img src="https://picsum.photos" alt="Вторая картинка" /><br/>
            
            <!-- ПРИМЕР 2: Текст на цветной плашке (фоне) через <div> -->
            <div style="background-color: #ffeaa7; color: #2d3436; padding: 10px; border-radius: 6px; margin: 10px 0;">
                А здесь находится текст на красивом желтом фоне в виде блока.
            </div>
            <br/>
            
            <img src="https://picsum.photos" alt="Третья картинка" /><br/>
            
            <!-- ПРИМЕР 3: Выделение отдельных слов цветом через <span> внутри обычного абзаца -->
            <p>Заключительный текст, где <span style="color: #2ed573; background-color: #e3fcef; padding: 2px 6px; border-radius: 4px;">некоторые слова</span> покрашены отдельно.</p>
        ]]></content:encoded>
    </item>
