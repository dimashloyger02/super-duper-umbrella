{
  "rewrites": [
    {
      "source": "/tg-api/(.*)",
      "destination": "https://api.telegram.org/$1"
    },
    {
      "source": "/youtube/(.*)",
      "destination": "https://m.youtube.com/$1"
    },
    {
      "source": "/tg-js-org/(.*)",
      "destination": "https://telegram.org/js/telegram-widget.js?23"
    }
  ]
}
